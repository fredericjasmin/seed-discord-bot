<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="mb-4">
    <h2 class="mb-1 text-white">Mis Servidores</h2>
    <p class="text-muted mb-0">Selecciona un servidor para configurar o invita al bot a tus otras comunidades.</p>
</div>

<% if (botInGuilds && botInGuilds.length > 0) { %>
    <h5 class="text-white mb-3" style="font-size: 1.05rem;"><i class="bi bi-check-circle-fill text-success me-2"></i>Servidores con Seed Bot</h5>
    <div class="row g-3 mb-5">
        <% botInGuilds.forEach(guild => { %>
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="guild-card">
                    <div>
                        <% if (guild.icon) { %>
                            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt="<%= guild.name %>" class="guild-icon">
                        <% } else { %>
                            <div class="guild-icon-default">
                                <%= guild.name.charAt(0) %>
                            </div>
                        <% } %>
                        <h6 class="guild-name mb-3" title="<%= guild.name %>"><%= guild.name %></h6>
                    </div>
                    <a href="/servers/<%= guild.id %>/settings" class="btn btn-primary btn-sm w-100 py-2"><i class="bi bi-sliders me-1"></i> Administrar</a>
                </div>
            </div>
        <% }); %>
    </div>
<% } %>

<% if (botNotInGuilds && botNotInGuilds.length > 0) { %>
    <h5 class="text-white mb-3" style="font-size: 1.05rem;"><i class="bi bi-plus-circle text-muted me-2"></i>Otros Servidores Disponibles</h5>
    <div class="row g-3">
        <% botNotInGuilds.forEach(guild => { %>
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="guild-card">
                    <div>
                        <% if (guild.icon) { %>
                            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt="<%= guild.name %>" class="guild-icon" style="opacity: 0.8;">
                        <% } else { %>
                            <div class="guild-icon-default" style="opacity: 0.8;">
                                <%= guild.name.charAt(0) %>
                            </div>
                        <% } %>
                        <h6 class="guild-name mb-3" title="<%= guild.name %>"><%= guild.name %></h6>
                    </div>
                    <a href="https://discord.com/oauth2/authorize?client_id=<%= botClientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>&disable_guild_select=true" class="btn btn-outline-light btn-sm w-100 py-2" target="_blank"><i class="bi bi-plus-lg me-1"></i> Invitar Bot</a>
                </div>
            </div>
        <% }); %>
    </div>
<% } %>

<% if ((!botInGuilds || botInGuilds.length === 0) && (!botNotInGuilds || botNotInGuilds.length === 0)) { %>
    <div class="card p-4 text-center">
        <i class="bi bi-shield-exclamation text-warning display-5 mb-2"></i>
        <h5 class="text-white">No se encontraron servidores administrables</h5>
        <p class="text-muted small mb-0">Asegúrate de tener permisos de "Administrador" o "Gestionar Servidor" en tu cuenta de Discord.</p>
    </div>
<% } %>

<%- include('partials/footer') %>