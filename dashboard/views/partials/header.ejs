<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seed Dashboard</title>
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        /* ===== VARIABLES CSS (Minimalista Verde Seed - Alto Contraste) ===== */
        :root {
            --bg-color: #0d1117;
            --surface-color: #161b22;
            --surface-hover: #21262d;
            --surface-border: #30363d;
            --accent-color: #00C851;
            --accent-hover: #00a844;
            --text-color: #f0f6fc;
            --text-muted: #94a3b8;
            --text-dim: #cbd5e1;
            --error-color: #e55353;
            --error-hover: #c93b3b;
            --sidebar-width: 240px;
            --border-radius: 8px;
            --border-radius-sm: 6px;
        }

        /* ===== BASE STYLES ===== */
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Poppins', sans-serif;
            font-size: 15px;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        /* Utilidades de texto nítido y legible */
        .text-muted {
            color: #94a3b8 !important;
        }

        .text-secondary {
            color: #a0aec0 !important;
        }

        .text-dim {
            color: #cbd5e1 !important;
        }

        p.text-muted, span.text-muted, div.text-muted, small.text-muted {
            color: #94a3b8 !important;
        }

        .command-description {
            color: #cbd5e1 !important;
            font-size: 0.88rem;
            line-height: 1.45;
        }

        /* Scrollbar Minimalista */
        ::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-color);
        }
        ::-webkit-scrollbar-thumb {
            background: #252a3a;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #333a50;
        }

        /* ===== LAYOUT ===== */
        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            padding: 32px 36px;
            background-color: var(--bg-color);
            min-height: 100vh;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--surface-color);
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px 14px;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--surface-border);
            z-index: 1000;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            padding: 6px 10px 18px 10px;
            margin-bottom: 8px;
            border-bottom: 1px solid var(--surface-border);
        }

        .sidebar-header h4 {
            color: #ffffff;
            font-weight: 600;
            font-size: 1.15rem;
            margin: 0;
        }

        .sidebar-heading {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-dim);
            font-weight: 600;
            padding: 10px 12px 4px 12px;
            margin-top: 6px;
        }

        .sidebar .nav-link {
            color: var(--text-muted);
            padding: 8px 12px;
            margin-bottom: 2px;
            border-radius: var(--border-radius-sm);
            font-size: 0.92rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .sidebar .nav-link i {
            margin-right: 10px;
            font-size: 1.05rem;
            width: 20px;
            text-align: center;
        }

        .sidebar .nav-link:hover {
            background-color: var(--surface-hover);
            color: #ffffff;
        }

        .sidebar .nav-link.active {
            background-color: var(--accent-color);
            color: #ffffff;
        }

        /* ===== USER PROFILE ===== */
        .user-profile {
            margin-top: auto;
            padding: 12px;
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: var(--border-radius-sm);
            border: 1px solid var(--surface-border);
        }

        .user-profile .user-details {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-profile .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-profile .user-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .btn-login {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: #fff;
            width: 100%;
            font-weight: 500;
            font-size: 0.9rem;
            border-radius: var(--border-radius-sm);
            padding: 8px;
        }

        .btn-login:hover {
            background-color: var(--accent-hover);
            border-color: var(--accent-hover);
            color: #fff;
        }

        /* ===== CARDS ===== */
        .card, .stat-card, .guild-card {
            background-color: var(--surface-color) !important;
            border-radius: var(--border-radius);
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid var(--surface-border) !important;
            color: var(--text-color);
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }

        .stat-card .card-title {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 8px;
        }

        .stat-card .card-text {
            color: #ffffff;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0;
        }

        .guild-card {
            text-align: center;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 22px;
        }

        .guild-card:hover, .card:hover {
            border-color: rgba(255, 255, 255, 0.14) !important;
        }

        .guild-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            margin: 0 auto 12px auto;
            display: block;
            object-fit: cover;
        }

        .guild-icon-default {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            margin: 0 auto 12px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--surface-hover);
            color: var(--accent-color);
            font-size: 1.6rem;
            font-weight: 600;
            border: 1px solid var(--surface-border);
        }

        .guild-icon-large {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            object-fit: cover;
        }

        .guild-icon-large.guild-icon-default {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--surface-hover);
            color: var(--accent-color);
            font-size: 1.5rem;
            font-weight: 600;
            border: 1px solid var(--surface-border);
        }

        .guild-name {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 16px;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ===== BOTONES ===== */
        .btn-primary {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            color: #ffffff;
            font-weight: 500;
            border-radius: var(--border-radius-sm);
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--accent-hover);
            border-color: var(--accent-hover);
            color: #ffffff;
        }

        .btn-success {
            background-color: #00C851;
            border-color: #00C851;
            color: #ffffff;
            font-weight: 500;
            border-radius: var(--border-radius-sm);
        }

        .btn-success:hover {
            background-color: var(--accent-hover);
            border-color: var(--accent-hover);
            color: #ffffff;
        }

        .btn-danger {
            background-color: var(--error-color);
            border-color: var(--error-color);
            color: #ffffff;
            border-radius: var(--border-radius-sm);
        }

        .btn-danger:hover {
            background-color: var(--error-hover);
            border-color: var(--error-hover);
        }

        .btn-outline-light {
            border-color: var(--surface-border);
            color: var(--text-color);
            border-radius: var(--border-radius-sm);
        }

        .btn-outline-light:hover {
            background-color: var(--surface-hover);
            border-color: rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        /* ===== FORM INPUTS ===== */
        .form-control, .form-select {
            background-color: #12141c !important;
            border: 1px solid var(--surface-border) !important;
            color: var(--text-color) !important;
            border-radius: var(--border-radius-sm);
            font-size: 0.92rem;
            padding: 8px 12px;
            transition: border-color 0.15s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent-color) !important;
            box-shadow: none !important;
            color: #ffffff !important;
            background-color: #12141c !important;
        }

        .form-control::placeholder {
            color: var(--text-dim) !important;
        }

        .form-label {
            color: #f0f6fc;
            font-weight: 500;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        /* ===== TOGGLE SWITCHES & CHECKBOXES (Centrado y Alineación Perfecta) ===== */
        .form-check {
            display: inline-flex !important;
            align-items: center !important;
            min-height: 1.8rem;
            padding-left: 0 !important;
            margin-bottom: 0.85rem;
            gap: 10px;
        }

        .form-check-input {
            float: none !important;
            margin: 0 !important;
            flex-shrink: 0;
            background-color: #21262d;
            border: 1px solid #484f58;
            cursor: pointer;
            width: 1.2em;
            height: 1.2em;
        }

        .form-switch {
            display: inline-flex !important;
            align-items: center !important;
            padding-left: 0 !important;
            margin-bottom: 0.85rem;
            gap: 10px;
        }

        .form-switch .form-check-input {
            width: 2.6em !important;
            height: 1.38em !important;
            float: none !important;
            margin: 0 !important;
            background-color: #21262d !important;
            border: 1px solid #484f58 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='2.8' fill='%23cbd5e1'/%3e%3c/svg%3e") !important;
            background-position: left 2px center !important;
            background-repeat: no-repeat !important;
            border-radius: 2em !important;
            transition: background-position 0.2s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, border-color 0.2s ease;
        }

        .form-switch .form-check-input:checked {
            background-color: #00C851 !important;
            border-color: #00C851 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='2.8' fill='%23ffffff'/%3e%3c/svg%3e") !important;
            background-position: right 2px center !important;
        }

        .form-switch .form-check-input:focus {
            border-color: #00C851 !important;
            outline: 0;
            box-shadow: 0 0 0 2px rgba(0, 200, 81, 0.2) !important;
        }

        .form-check-label {
            color: #f0f6fc !important;
            cursor: pointer;
            user-select: none;
            font-size: 0.92rem;
            line-height: 1.2;
            margin: 0 !important;
            display: inline-block;
        }

        /* ===== COLOR PICKER ===== */
        input[type="color"].form-control-color {
            height: 40px;
            padding: 4px;
            background-color: #161b22 !important;
            border: 1px solid #30363d !important;
            border-radius: var(--border-radius-sm);
            cursor: pointer;
        }

        input[type="color"].form-control-color::-webkit-color-swatch-wrapper {
            padding: 0;
        }

        input[type="color"].form-control-color::-webkit-color-swatch {
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

        .form-select option {
            background-color: var(--surface-color);
            color: var(--text-color);
        }

        /* ===== TABLAS ===== */
        .table {
            background-color: var(--surface-color) !important;
            color: var(--text-color);
            border-radius: var(--border-radius);
            border: 1px solid var(--surface-border);
            margin-bottom: 0;
            font-size: 0.92rem;
        }

        .table thead th {
            background-color: #12141d !important;
            color: var(--text-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 12px 16px;
            border-bottom: 1px solid var(--surface-border);
        }

        .table tbody td {
            background-color: var(--surface-color) !important;
            color: var(--text-color) !important;
            padding: 12px 16px;
            vertical-align: middle;
            border-bottom: 1px solid var(--surface-border);
        }

        .table-hover tbody tr:hover td {
            background-color: var(--surface-hover) !important;
        }

        /* ===== LIST GROUPS ===== */
        .list-group-item {
            background-color: #12141c !important;
            border: 1px solid var(--surface-border) !important;
            color: var(--text-color) !important;
            border-radius: var(--border-radius-sm) !important;
            margin-bottom: 6px;
            padding: 10px 14px;
        }

        /* Backdrop para móvil */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.7);
            z-index: 999;
            backdrop-filter: blur(2px);
        }

        .sidebar-backdrop.show {
            display: block;
        }

        /* ===== RESPONSIVE (Móviles y Tablets) ===== */
        @media (max-width: 991.98px) {
            .sidebar {
                left: -270px;
                width: 260px;
                transition: left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                box-shadow: 0 0 25px rgba(0, 0, 0, 0.8);
                border-right: 1px solid var(--surface-border);
                z-index: 1050;
            }

            .sidebar.show {
                left: 0;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
                padding: 68px 16px 32px 16px;
            }

            .mobile-sidebar-toggle {
                display: flex !important;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                background-color: var(--surface-color);
                border: 1px solid var(--surface-border);
                border-radius: var(--border-radius-sm);
                position: fixed;
                top: 14px;
                left: 14px;
                z-index: 998;
                color: var(--text-color);
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
            }

            .mobile-sidebar-toggle:hover {
                background-color: var(--surface-hover);
                color: #ffffff;
            }

            .guild-header-banner {
                padding: 16px;
            }

            .settings-nav .nav-link {
                font-size: 0.88rem;
                padding: 7px 12px;
            }
        }

        @media (max-width: 576px) {
            .main-content {
                padding: 64px 12px 24px 12px;
            }

            .card, .stat-card, .guild-card {
                padding: 16px;
            }

            .stat-card .card-text {
                font-size: 1.6rem;
            }

            .settings-nav {
                display: flex;
                flex-wrap: nowrap !important;
                overflow-x: auto;
                padding-bottom: 6px;
                -webkit-overflow-scrolling: touch;
            }

            .settings-nav .nav-link {
                white-space: nowrap;
                flex-shrink: 0;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-container">