<nav class="sidebar">
    <div class="sidebar-header">
        <div class="d-flex align-items-center">
            <img src="/images/logow.png" alt="Seed Logo" style="width: 28px; height: auto; margin-right: 10px;">
            <h4>Seed</h4>
        </div>
        <button class="btn btn-link text-muted d-lg-none ms-auto p-0" id="sidebarToggle">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Menú Principal -->
    <div class="sidebar-heading">Principal</div>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/">
                <i class="bi bi-house"></i>
                Inicio
            </a>
        </li>
        <% if (user) { %>
        <li class="nav-item">
            <a class="nav-link <%= path === '/servers' ? 'active' : '' %>" href="/servers">
                <i class="bi bi-gear"></i>
                Mis Servidores
            </a>
        </li>
        <% } %>
        <li class="nav-item">
            <a class="nav-link <%= path === '/commands' ? 'active' : '' %>" href="/commands">
                <i class="bi bi-terminal"></i>
                Comandos
            </a>
        </li>
    </ul>

    <!-- Comunidad y Economía -->
    <div class="sidebar-heading">Comunidad & Economía</div>
    <ul class="nav flex-column">
        <% if (user) { %>
        <li class="nav-item">
            <a class="nav-link <%= path === '/shop' ? 'active' : '' %>" href="/shop">
                <i class="bi bi-bag"></i>
                Tienda
            </a>
        </li>
        <% } %>
        <li class="nav-item">
            <a class="nav-link <%= path === '/leaderboard' ? 'active' : '' %>" href="/leaderboard">
                <i class="bi bi-trophy"></i>
                Clasificación
            </a>
        </li>
    </ul>

    <!-- Sistema -->
    <div class="sidebar-heading">Sistema</div>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link <%= path === '/info' ? 'active' : '' %>" href="/info">
                <i class="bi bi-info-circle"></i>
                Estado del Bot
            </a>
        </li>
        <% if (user && user.id === BOT_OWNER_ID) { %>
        <li class="nav-item">
            <a class="nav-link <%= path === '/admin' ? 'active' : '' %>" href="/admin">
                <i class="bi bi-shield-lock"></i>
                Panel Admin
            </a>
        </li>
        <% } %>
    </ul>

    <!-- Perfil de Usuario -->
    <div class="user-profile">
        <% if (user) { %>
            <div class="user-details">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="Avatar" class="user-avatar">
                <div style="min-width: 0; flex: 1;">
                    <div class="user-name"><%= user.username %></div>
                    <div class="text-muted small" style="font-size: 0.75rem;">Conectado</div>
                </div>
                <a href="/auth/logout" class="btn btn-outline-danger btn-sm p-1 px-2" title="Cerrar sesión">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
            <a href="/profile" class="btn btn-outline-light btn-sm w-100 mt-2 py-1" style="font-size: 0.82rem;">Ver Perfil</a>
        <% } else { %>
            <a href="/auth/discord" class="btn btn-login"><i class="bi bi-discord me-1"></i> Iniciar Sesión</a>
        <% } %>
    </div>
</nav>

<main class="main-content">
    <button class="btn mobile-sidebar-toggle text-white d-lg-none" id="contentSidebarToggle">
        <i class="bi bi-list"></i>
    </button>