                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="automodFilterInvites" name="automodFilterInvites" <%= guild.config.automod && guild.config.automod.filterInvites ? 'checked' : '' %>>
                                    <label class="form-check-label" for="automodFilterInvites">Bloquear Invitaciones</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="automodFilterLinks" name="automodFilterLinks" <%= guild.config.automod && guild.config.automod.filterLinks ? 'checked' : '' %>>
                                    <label class="form-check-label" for="automodFilterLinks">Bloquear Links</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="automodFilterCaps" name="automodFilterCaps" <%= guild.config.automod && guild.config.automod.filterCaps ? 'checked' : '' %>>
                                    <label class="form-check-label" for="automodFilterCaps">Bloquear Mayúsculas</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="automodAction" class="form-label">Acción</label>
                                <select class="form-select" id="automodAction" name="automodAction">
                                    <option value="delete" <%= guild.config.automod && guild.config.automod.action === 'delete' ? 'selected' : '' %>>Eliminar mensaje</option>
                                    <option value="warn" <%= guild.config.automod && guild.config.automod.action === 'warn' ? 'selected' : '' %>>Advertir usuario</option>
                                    <option value="mute" <%= guild.config.automod && guild.config.automod.action === 'mute' ? 'selected' : '' %>>Mutear usuario</option>
                                    <option value="kick" <%= guild.config.automod && guild.config.automod.action === 'kick' ? 'selected' : '' %>>Expulsar</option>
                                    <option value="ban" <%= guild.config.automod && guild.config.automod.action === 'ban' ? 'selected' : '' %>>Banear</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="automodMuteMinutes" class="form-label">Minutos de Muteo</label>
                                <input type="number" class="form-control" id="automodMuteMinutes" name="automodMuteMinutes" min="1" max="1440" value="<%= guild.config.automod && guild.config.automod.muteMinutes ? guild.config.automod.muteMinutes : 10 %>">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="automodLogChannelId" class="form-label">Canal de Logs</label>
                                <select class="form-select" id="automodLogChannelId" name="automodLogChannelId">
                                    <option value="">Ninguno</option>
                                    <% channels.forEach(channel => { %>
                                        <% if (channel.type === 0) { %>
                                            <option value="<%= channel.id %>" <%= guild.config.automod && guild.config.automod.logChannelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                        <% } %>
                                    <% }); %>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar AutoMod</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: ROLES & REACCIONES ================= -->
        <div class="tab-pane fade" id="tab-roles" role="tabpanel">
            <div class="row">
                <div class="col-lg-5 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-person-check-fill text-success me-2"></i>Auto Rol al Unirse</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-roles" method="POST">
                                <input type="hidden" name="settingType" value="autoRole">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="autoRoleEnabled" name="autoRoleEnabled" <%= guild.config.autoRole && guild.config.autoRole.enabled ? 'checked' : '' %>>
                                    <label class="form-check-label" for="autoRoleEnabled">Habilitar Auto Rol</label>
                                </div>
                                <div class="mb-3">
                                    <label for="autoRoleRole" class="form-label">Rol a Asignar</label>
                                    <select class="form-select" id="autoRoleRole" name="autoRoleRole">
                                        <option value="">Seleccionar Rol</option>
                                        <% roles.forEach(role => { %>
                                            <option value="<%= role.id %>" <%= guild.config.autoRole && guild.config.autoRole.roleId === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save me-1"></i> Guardar Auto Rol</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-emoji-smile-fill text-warning me-2"></i>Crear Reaction Role</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-roles" method="POST">
                                <input type="hidden" name="settingType" value="reactionRoleCreate">
                                <div class="mb-3">
                                    <label for="rrChannel" class="form-label">Canal</label>
                                    <select class="form-select" id="rrChannel" name="rrChannel" required>
                                        <option value="">Seleccionar Canal</option>
                                        <% channels.forEach(channel => { %>
                                            <% if (channel.type === 0) { %>
                                                <option value="<%= channel.id %>">#<%= channel.name %></option>
                                            <% } %>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="rrTitle" class="form-label">Título del Embed</label>
                                    <input type="text" class="form-control" id="rrTitle" name="rrTitle" placeholder="Elige tus roles" required>
                                </div>
                                <div class="mb-3">
                                    <label for="rrDescription" class="form-label">Descripción</label>
                                    <textarea class="form-control" id="rrDescription" name="rrDescription" rows="2" placeholder="Reacciona a los emojis para obtener roles." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-success"><i class="bi bi-send me-1"></i> Publicar Reaction Role</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: LOGS ================= -->
        <div class="tab-pane fade" id="tab-logs" role="tabpanel">
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-journal-text text-info me-2"></i>Logs del Servidor</div>
                <div class="card-body">
                    <form action="/servers/<%= currentGuild.id %>/settings#tab-logs" method="POST">
                        <input type="hidden" name="settingType" value="loggingConfig">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="logsEnabled" name="logsEnabled" <%= guild.config.logging && guild.config.logging.enabled ? 'checked' : '' %>>
                            <label class="form-check-label" for="logsEnabled"><strong>Habilitar Logs</strong></label>
                        </div>
                        <div class="mb-3">
                            <label for="logsChannel" class="form-label">Canal de Logs</label>
                            <select class="form-select" id="logsChannel" name="logsChannel">
                                <option value="">Seleccionar Canal</option>
                                <% channels.forEach(channel => { %>
                                    <% if (channel.type === 0) { %>
                                        <option value="<%= channel.id %>" <%= guild.config.logging && guild.config.logging.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                    <% } %>
                                <% }); %>
                            </select>
                        </div>
                        <label class="form-label">Eventos a Registrar:</label>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="logMessageUpdates" name="logMessageUpdates" <%= guild.config.logging && guild.config.logging.logMessageUpdates ? 'checked' : '' %>>
                                    <label class="form-check-label" for="logMessageUpdates">Mensajes Editados</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="logMessageDeletes" name="logMessageDeletes" <%= guild.config.logging && guild.config.logging.logMessageDeletes ? 'checked' : '' %>>
                                    <label class="form-check-label" for="logMessageDeletes">Mensajes Eliminados</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="logMemberUpdates" name="logMemberUpdates" <%= guild.config.logging && guild.config.logging.logMemberUpdates ? 'checked' : '' %>>
                                    <label class="form-check-label" for="logMemberUpdates">Actualizaciones de Miembros</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="logChannelUpdates" name="logChannelUpdates" <%= guild.config.logging && guild.config.logging.logChannelUpdates ? 'checked' : '' %>>
                                    <label class="form-check-label" for="logChannelUpdates">Eventos de Canales</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="logBanEvents" name="logBanEvents" <%= guild.config.logging && guild.config.logging.logBanEvents ? 'checked' : '' %>>
                                    <label class="form-check-label" for="logBanEvents">Baneos / Desbaneos</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="logKickEvents" name="logKickEvents" <%= guild.config.logging && guild.config.logging.logKickEvents ? 'checked' : '' %>>
                                    <label class="form-check-label" for="logKickEvents">Expulsiones</label>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar Logs</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: SORTEOS ================= -->
        <div class="tab-pane fade" id="tab-giveaways" role="tabpanel">
            <div class="row">
                <div class="col-lg-5 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-plus-circle-fill text-success me-2"></i>Crear Sorteo</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/giveaways" method="POST">
                                <div class="mb-3">
                                    <label for="giveawayPrize" class="form-label">Premio</label>
                                    <input type="text" class="form-control" id="giveawayPrize" name="prize" placeholder="Ej: Nitro 1 Mes" required>
                                </div>
                                <div class="mb-3">
                                    <label for="giveawayWinners" class="form-label">Ganadores</label>
                                    <input type="number" class="form-control" id="giveawayWinners" name="winners" min="1" value="1" required>
                                </div>
                                <div class="mb-3">
                                    <label for="giveawayChannel" class="form-label">Canal del Sorteo</label>
                                    <select class="form-select" id="giveawayChannel" name="channelId" required>
                                        <option value="">Seleccionar Canal</option>
                                        <% channels.forEach(channel => { %>
                                            <% if (channel.type === 0) { %>
                                                <option value="<%= channel.id %>">#<%= channel.name %></option>
                                            <% } %>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="giveawayDuration" class="form-label">Duración</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="giveawayDuration" name="durationValue" min="1" value="60" required>
                                        <select class="form-select" id="giveawayDurationUnit" name="durationUnit" required>
                                            <option value="minutes" selected>Minutos</option>
                                            <option value="hours">Horas</option>
                                            <option value="days">Días</option>
                                        </select>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success w-100"><i class="bi bi-gift-fill me-1"></i> Iniciar Sorteo</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-gift text-warning me-2"></i>Sorteos Registrados</div>
                        <div class="card-body">
                            <% if (typeof giveaways !== 'undefined' && giveaways.length > 0) { %>
                                <ul class="list-group">
                                    <% giveaways.forEach(gw => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <strong><%= gw.prize %></strong>
                                                <div class="text-muted small">Ganadores: <%= gw.winners %> | Finaliza: <%= gw.endAt.toLocaleString() %></div>
                                            </div>
                                            <div>
                                                <span class="badge <%= gw.ended ? 'bg-secondary' : 'bg-success' %> me-2"><%= gw.ended ? 'Finalizado' : 'Activo' %></span>
                                                <% if (!gw.ended) { %>
                                                    <form action="/servers/<%= currentGuild.id %>/giveaways/<%= gw._id %>/end" method="POST" style="display:inline;">
                                                        <button type="submit" class="btn btn-danger btn-sm">Finalizar</button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <p class="text-muted">No hay sorteos activos en este momento.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Manejar persistencia de pestañas por URL Hash
        const hash = window.location.hash;
        if (hash) {
            const triggerEl = document.querySelector(`button[data-bs-target="${hash}"]`);
            if (triggerEl) {
                const tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }
        }

        // Al cambiar de pestaña, actualizar el hash en la URL
        const tabBtns = document.querySelectorAll('button[data-bs-toggle="pill"]');
        tabBtns.forEach(btn => {
            btn.addEventListener('shown.bs.tab', (e) => {
                const target = e.target.getAttribute('data-bs-target');
                history.replaceState(null, null, target);
            });
        });

        // Feedback de guardado
        const urlParams = new URLSearchParams(window.location.search);
        const success = urlParams.get('success');
        const error = urlParams.get('error');
        const placeholder = document.getElementById('alert-placeholder');

        if (success) {
            placeholder.innerHTML = `
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> ¡Configuración guardada exitosamente!
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
        } else if (error) {
            placeholder.innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Ocurrió un error al procesar la solicitud.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
        }

        if (success || error) {
            const cleanUrl = window.location.pathname + (window.location.hash || '');
            window.history.replaceState({}, document.title, cleanUrl);
        }
    });
</script>

<%- include('partials/footer') %>