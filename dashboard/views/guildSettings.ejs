        <!-- ================= PESTAÑA: GESTOR DE SANCIONES ================= -->
        <div class="tab-pane fade" id="tab-warns" role="tabpanel">
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-exclamation-octagon-fill text-danger me-2"></i>Historial de Advertencias y Sanciones</div>
                <div class="card-body">
                    <% if (guild.warnings && guild.warnings.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Usuario (ID)</th>
                                        <th>Moderador (ID)</th>
                                        <th>Razón</th>
                                        <th>Fecha</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% guild.warnings.forEach(warn => { %>
                                        <tr>
                                            <td><code><%= warn.userId %></code></td>
                                            <td><code><%= warn.moderatorId %></code></td>
                                            <td><%= warn.reason %></td>
                                            <td><%= new Date(warn.timestamp).toLocaleDateString() %></td>
                                            <td>
                                                <form action="/servers/<%= currentGuild.id %>/settings#tab-warns" method="POST" style="margin: 0;">
                                                    <input type="hidden" name="settingType" value="warnRemove">
                                                    <input type="hidden" name="warnId" value="<%= warn._id %>">
                                                    <button type="submit" class="btn btn-danger btn-sm" title="Revocar advertencia"><i class="bi bi-trash"></i> Revocar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No hay advertencias activas registradas en este servidor.</p>
                    <% } %>
                </div>
            </div>
        </div>

