<%- include('partials/header') %>
<%- include('partials/navbar') %>

<style>
    /* Estilos de pestañas modernas y compactas */
    .settings-nav .nav-link {
        color: var(--text-muted);
        border-radius: var(--border-radius-sm);
        padding: 9px 16px;
        margin-right: 6px;
        margin-bottom: 8px;
        font-weight: 500;
        font-size: 0.95rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }
    .settings-nav .nav-link:hover {
        color: #fff;
        background: var(--surface-hover);
    }
    .settings-nav .nav-link.active {
        background: var(--accent-color) !important;
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(0, 200, 81, 0.25);
    }
    .guild-header-banner {
        background: linear-gradient(135deg, rgba(0, 200, 81, 0.15), rgba(42, 45, 66, 0.9));
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--border-radius);
        padding: 22px;
        margin-bottom: 22px;
    }
</style>

<div class="container-fluid mt-2">
    <div id="alert-placeholder"></div>

    <!-- Guild Header Banner -->
    <div class="guild-header-banner d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <% if (currentGuild.icon) { %>
                <img src="https://cdn.discordapp.com/icons/<%= currentGuild.id %>/<%= currentGuild.icon %>.png?size=128" alt="<%= currentGuild.name %>" class="guild-icon-large">
            <% } else { %>
                <div class="guild-icon-large guild-icon-default"><%= currentGuild.name.charAt(0) %></div>
            <% } %>
            <div>
                <h3 class="mb-1 text-white"><%= currentGuild.name %></h3>
                <span class="badge bg-dark border border-secondary text-muted">ID: <%= currentGuild.id %></span>
                <span class="badge bg-dark border border-secondary text-muted ms-1"><i class="bi bi-hash"></i> <%= channels.length %> Canales</span>
                <span class="badge bg-dark border border-secondary text-muted ms-1"><i class="bi bi-shield-lock"></i> <%= roles.length %> Roles</span>
            </div>
        </div>
        <div>
            <a href="/servers" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Volver a Mis Servidores</a>
        </div>
    </div>

    <!-- Navegación por Pestañas -->
    <ul class="nav nav-pills settings-nav mb-4 flex-wrap" id="settingsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-welcome-btn" data-bs-toggle="pill" data-bs-target="#tab-welcome" type="button" role="tab"><i class="bi bi-door-open-fill me-1"></i> Bienvenidas</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-verification-btn" data-bs-toggle="pill" data-bs-target="#tab-verification" type="button" role="tab"><i class="bi bi-shield-check me-1"></i> Verificación</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-leveling-btn" data-bs-toggle="pill" data-bs-target="#tab-leveling" type="button" role="tab"><i class="bi bi-graph-up-arrow me-1"></i> Niveles & XP</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-tickets-btn" data-bs-toggle="pill" data-bs-target="#tab-tickets" type="button" role="tab"><i class="bi bi-ticket-perforated-fill me-1"></i> Tickets</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-tempvoice-btn" data-bs-toggle="pill" data-bs-target="#tab-tempvoice" type="button" role="tab"><i class="bi bi-mic-fill me-1"></i> Voz Temporal</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-customcommands-btn" data-bs-toggle="pill" data-bs-target="#tab-customcommands" type="button" role="tab"><i class="bi bi-robot me-1"></i> Auto-Respuestas</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-suggestions-btn" data-bs-toggle="pill" data-bs-target="#tab-suggestions" type="button" role="tab"><i class="bi bi-lightbulb-fill me-1"></i> Sugerencias</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-serverstats-btn" data-bs-toggle="pill" data-bs-target="#tab-serverstats" type="button" role="tab"><i class="bi bi-bar-chart-line-fill me-1"></i> Estadísticas</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-birthdays-btn" data-bs-toggle="pill" data-bs-target="#tab-birthdays" type="button" role="tab"><i class="bi bi-cake2-fill me-1"></i> Cumpleaños</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-automod-btn" data-bs-toggle="pill" data-bs-target="#tab-automod" type="button" role="tab"><i class="bi bi-shield-shaded me-1"></i> AutoMod</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-roles-btn" data-bs-toggle="pill" data-bs-target="#tab-roles" type="button" role="tab"><i class="bi bi-tags-fill me-1"></i> Roles</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-webembed-btn" data-bs-toggle="pill" data-bs-target="#tab-webembed" type="button" role="tab"><i class="bi bi-layout-text-window-reverse me-1"></i> Enviar Embed</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-warns-btn" data-bs-toggle="pill" data-bs-target="#tab-warns" type="button" role="tab"><i class="bi bi-exclamation-octagon-fill me-1"></i> Sanciones</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-logs-btn" data-bs-toggle="pill" data-bs-target="#tab-logs" type="button" role="tab"><i class="bi bi-journal-text me-1"></i> Logs</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-giveaways-btn" data-bs-toggle="pill" data-bs-target="#tab-giveaways" type="button" role="tab"><i class="bi bi-gift-fill me-1"></i> Sorteos</button>
        </li>
    </ul>

    <!-- Contenido de las Pestañas -->
    <div class="tab-content" id="settingsTabsContent">

        <!-- ================= PESTAÑA: BIENVENIDAS & DESPEDIDAS ================= -->
        <div class="tab-pane fade show active" id="tab-welcome" role="tabpanel">
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-person-plus-fill text-success me-2"></i>Bienvenidas</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-welcome" method="POST">
                                <input type="hidden" name="settingType" value="welcome">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="welcomeEnabled" name="welcomeEnabled" <%= guild.config.welcome && guild.config.welcome.enabled ? 'checked' : '' %>>
                                    <label class="form-check-label" for="welcomeEnabled">Habilitar Mensajes de Bienvenida</label>
                                </div>
                                <div class="mb-3">
                                    <label for="welcomeChannel" class="form-label">Canal de Bienvenida</label>
                                    <select class="form-select" id="welcomeChannel" name="welcomeChannel">
                                        <option value="">Seleccionar Canal</option>
                                        <% channels.forEach(channel => { %>
                                            <% if (channel.type === 0) { %>
                                                <option value="<%= channel.id %>" <%= guild.config.welcome && guild.config.welcome.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                            <% } %>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="welcomeMessage" class="form-label">Mensaje en Texto Plano</label>
                                    <textarea class="form-control" id="welcomeMessage" name="welcomeMessage" rows="2"><%= guild.config.welcome ? guild.config.welcome.message : '' %></textarea>
                                    <small class="form-text text-muted">Variables: <code>{user.mention}</code>, <code>{user.tag}</code>, <code>{guild.name}</code>, <code>{guild.memberCount}</code></small>
                                </div>
                                <hr>
                                <h6>Personalización de Embed</h6>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="welcomeUseEmbed" name="welcomeUseEmbed" <%= guild.config.welcome && guild.config.welcome.useEmbed ? 'checked' : '' %>>
                                    <label class="form-check-label" for="welcomeUseEmbed">Enviar como Embed Estilizado</label>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="welcomeEmbedColor" class="form-label">Color del Embed</label>
                                        <input type="color" class="form-control form-control-color w-100" id="welcomeEmbedColor" name="welcomeEmbedColor" value="<%= guild.config.welcome && guild.config.welcome.embedColor ? guild.config.welcome.embedColor : '#00C851' %>">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="welcomeEmbedTitle" class="form-label">Título del Embed</label>
                                        <input type="text" class="form-control" id="welcomeEmbedTitle" name="welcomeEmbedTitle" value="<%= guild.config.welcome ? guild.config.welcome.embedTitle : '¡Bienvenido/a!' %>">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="welcomeEmbedDescription" class="form-label">Descripción del Embed</label>
                                    <textarea class="form-control" id="welcomeEmbedDescription" name="welcomeEmbedDescription" rows="2"><%= guild.config.welcome ? guild.config.welcome.embedDescription : 'Bienvenido {user.mention} a {guild.name}!' %></textarea>
                                </div>
                                <div class="mb-3">
                                    <label for="welcomeEmbedFooter" class="form-label">Pie de Página</label>
                                    <input type="text" class="form-control" id="welcomeEmbedFooter" name="welcomeEmbedFooter" value="<%= guild.config.welcome ? guild.config.welcome.embedFooter : '' %>">
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="welcomeEmbedThumbnail" name="welcomeEmbedThumbnail" <%= guild.config.welcome && guild.config.welcome.embedThumbnail ? 'checked' : '' %>>
                                    <label class="form-check-label" for="welcomeEmbedThumbnail">Mostrar Avatar del Usuario como Miniatura</label>
                                </div>
                                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save me-1"></i> Guardar Bienvenida</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-person-dash-fill text-danger me-2"></i>Despedidas</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-welcome" method="POST">
                                <input type="hidden" name="settingType" value="farewell">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="farewellEnabled" name="farewellEnabled" <%= guild.config.farewell && guild.config.farewell.enabled ? 'checked' : '' %>>
                                    <label class="form-check-label" for="farewellEnabled">Habilitar Mensajes de Despedida</label>
                                </div>
                                <div class="mb-3">
                                    <label for="farewellChannel" class="form-label">Canal de Despedida</label>
                                    <select class="form-select" id="farewellChannel" name="farewellChannel">
                                        <option value="">Seleccionar Canal</option>
                                        <% channels.forEach(channel => { %>
                                            <% if (channel.type === 0) { %>
                                                <option value="<%= channel.id %>" <%= guild.config.farewell && guild.config.farewell.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                            <% } %>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="farewellMessage" class="form-label">Mensaje en Texto Plano</label>
                                    <textarea class="form-control" id="farewellMessage" name="farewellMessage" rows="2"><%= guild.config.farewell ? guild.config.farewell.message : '' %></textarea>
                                </div>
                                <hr>
                                <h6>Personalización de Embed</h6>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="farewellUseEmbed" name="farewellUseEmbed" <%= guild.config.farewell && guild.config.farewell.useEmbed ? 'checked' : '' %>>
                                    <label class="form-check-label" for="farewellUseEmbed">Enviar como Embed</label>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="farewellEmbedColor" class="form-label">Color del Embed</label>
                                        <input type="color" class="form-control form-control-color w-100" id="farewellEmbedColor" name="farewellEmbedColor" value="<%= guild.config.farewell && guild.config.farewell.embedColor ? guild.config.farewell.embedColor : '#ff4444' %>">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="farewellEmbedTitle" class="form-label">Título del Embed</label>
                                        <input type="text" class="form-control" id="farewellEmbedTitle" name="farewellEmbedTitle" value="<%= guild.config.farewell ? guild.config.farewell.embedTitle : '¡Hasta pronto!' %>">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="farewellEmbedDescription" class="form-label">Descripción del Embed</label>
                                    <textarea class="form-control" id="farewellEmbedDescription" name="farewellEmbedDescription" rows="2"><%= guild.config.farewell ? guild.config.farewell.embedDescription : 'Adiós {user.tag}. Ahora somos {guild.memberCount} miembros.' %></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save me-1"></i> Guardar Despedida</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: VERIFICACIÓN ================= -->
        <div class="tab-pane fade" id="tab-verification" role="tabpanel">
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-shield-check text-success me-2"></i>Sistema de Verificación & Anti-Raid</div>
                <div class="card-body">
                    <form action="/servers/<%= currentGuild.id %>/settings#tab-verification" method="POST">
                        <input type="hidden" name="settingType" value="verificationConfig">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="verificationEnabled" name="verificationEnabled" <%= guild.config.verification && guild.config.verification.enabled ? 'checked' : '' %>>
                            <label class="form-check-label" for="verificationEnabled"><strong>Habilitar Verificación de Miembros</strong></label>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="verificationChannel" class="form-label">Canal del Panel de Verificación</label>
                                <select class="form-select" id="verificationChannel" name="verificationChannel">
                                    <option value="">Seleccionar Canal</option>
                                    <% channels.forEach(channel => { %>
                                        <% if (channel.type === 0) { %>
                                            <option value="<%= channel.id %>" <%= guild.config.verification && guild.config.verification.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                        <% } %>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="verificationRole" class="form-label">Rol a Otorgar al Verificarse</label>
                                <select class="form-select" id="verificationRole" name="verificationRole">
                                    <option value="">Seleccionar Rol</option>
                                    <% roles.forEach(role => { %>
                                        <option value="<%= role.id %>" <%= guild.config.verification && guild.config.verification.roleId === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="verificationTitle" class="form-label">Título del Embed</label>
                                <input type="text" class="form-control" id="verificationTitle" name="verificationTitle" value="<%= guild.config.verification ? guild.config.verification.title : '🛡️ Verificación de Servidor' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="verificationColor" class="form-label">Color del Embed</label>
                                <input type="color" class="form-control form-control-color w-100" id="verificationColor" name="verificationColor" value="<%= guild.config.verification ? guild.config.verification.color : '#00C851' %>">
                            </div>
                            <div class="col-12 mb-3">
                                <label for="verificationDescription" class="form-label">Descripción / Instrucciones</label>
                                <textarea class="form-control" id="verificationDescription" name="verificationDescription" rows="2"><%= guild.config.verification ? guild.config.verification.description : 'Haz clic en el botón de abajo para verificarte y obtener acceso a todos los canales del servidor.' %></textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="verificationButtonLabel" class="form-label">Texto del Botón</label>
                                <input type="text" class="form-control" id="verificationButtonLabel" name="verificationButtonLabel" value="<%= guild.config.verification ? guild.config.verification.buttonLabel : 'Verificarme' %>">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="verificationButtonEmoji" class="form-label">Emoji del Botón</label>
                                <input type="text" class="form-control" id="verificationButtonEmoji" name="verificationButtonEmoji" value="<%= guild.config.verification ? guild.config.verification.buttonEmoji : '✅' %>">
                            </div>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="sendVerificationMessage" name="sendVerificationMessage">
                            <label class="form-check-label text-warning" for="sendVerificationMessage"><strong>Publicar panel de verificación en el canal seleccionado al guardar</strong></label>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar Ajustes de Verificación</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: NIVELES & XP ================= -->
        <div class="tab-pane fade" id="tab-leveling" role="tabpanel">
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-trophy-fill text-warning me-2"></i>Ajustes de Niveles</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-leveling" method="POST">
                                <input type="hidden" name="settingType" value="levelingConfig">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="levelingEnabled" name="levelingEnabled" <%= guild.config.leveling && guild.config.leveling.enabled ? 'checked' : '' %>>
                                    <label class="form-check-label" for="levelingEnabled"><strong>Habilitar Ganancia de XP y Niveles</strong></label>
                                </div>
                                <div class="mb-3">
                                    <label for="levelingChannel" class="form-label">Canal de Anuncios de Nivel</label>
                                    <select class="form-select" id="levelingChannel" name="levelingChannel">
                                        <option value="">Canal actual donde se sube de nivel</option>
                                        <% channels.forEach(channel => { %>
                                            <% if (channel.type === 0) { %>
                                                <option value="<%= channel.id %>" <%= guild.config.leveling && guild.config.leveling.channelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                            <% } %>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="levelingMessage" class="form-label">Mensaje de Subida de Nivel</label>
                                    <textarea class="form-control" id="levelingMessage" name="levelingMessage" rows="2"><%= guild.config.leveling && guild.config.leveling.message ? guild.config.leveling.message : '🎉 ¡Felicidades {user.mention}! Has subido al nivel **{level}**!' %></textarea>
                                    <small class="form-text text-muted">Variables: <code>{user.mention}</code>, <code>{user.username}</code>, <code>{level}</code></small>
                                </div>
                                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save me-1"></i> Guardar Ajustes de Niveles</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-award-fill text-success me-2"></i>Recompensas de Rol por Nivel</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-leveling" method="POST" class="mb-4">
                                <input type="hidden" name="settingType" value="levelRewardAdd">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label for="rewardLevel" class="form-label">Nivel</label>
                                        <input type="number" class="form-control" id="rewardLevel" name="rewardLevel" min="1" max="100" placeholder="Ej: 5" required>
                                    </div>
                                    <div class="col-md-5">
                                        <label for="rewardRole" class="form-label">Rol a Otorgar</label>
                                        <select class="form-select" id="rewardRole" name="rewardRole" required>
                                            <option value="">Seleccionar Rol</option>
                                            <% roles.forEach(role => { %>
                                                <option value="<%= role.id %>">@<%= role.name %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-lg"></i> Añadir</button>
                                    </div>
                                </div>
                            </form>

                            <% if (guild.config.leveling && guild.config.leveling.levelRoles && guild.config.leveling.levelRoles.length > 0) { %>
                                <ul class="list-group">
                                    <% guild.config.leveling.levelRoles.forEach(reward => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <span class="badge bg-warning text-dark me-2">Nivel <%= reward.level %></span>
                                                <span class="badge bg-secondary">@<%= roles.find(r => r.id === reward.roleId) ? roles.find(r => r.id === reward.roleId).name : 'Rol desconocido' %></span>
                                            </span>
                                            <form action="/servers/<%= currentGuild.id %>/settings#tab-leveling" method="POST" style="margin: 0;">
                                                <input type="hidden" name="settingType" value="levelRewardRemove">
                                                <input type="hidden" name="rewardLevel" value="<%= reward.level %>">
                                                <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <p class="text-muted small">No hay roles de recompensa configurados aún.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: AUTO-RESPUESTAS ================= -->
        <div class="tab-pane fade" id="tab-customcommands" role="tabpanel">
            <div class="row">
                <div class="col-lg-5 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-plus-circle-fill text-success me-2"></i>Crear Auto-Respuesta</div>
                        <div class="card-body">
                            <form action="/servers/<%= currentGuild.id %>/settings#tab-customcommands" method="POST">
                                <input type="hidden" name="settingType" value="customCommandAdd">
                                <div class="mb-3">
                                    <label for="cmdTrigger" class="form-label">Palabra Clave o Comando Disparador</label>
                                    <input type="text" class="form-control" id="cmdTrigger" name="cmdTrigger" placeholder="Ej: !ip o !reglas" required>
                                </div>
                                <div class="mb-3">
                                    <label for="cmdMatchType" class="form-label">Tipo de Coincidencia</label>
                                    <select class="form-select" id="cmdMatchType" name="cmdMatchType">
                                        <option value="exact">Coincidencia Exacta (el mensaje es solo la palabra clave)</option>
                                        <option value="contains">Contiene la palabra (en cualquier parte del texto)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="cmdResponse" class="form-label">Respuesta del Bot</label>
                                    <textarea class="form-control" id="cmdResponse" name="cmdResponse" rows="3" placeholder="Texto de respuesta. Soporta {user.mention}, {guild.name}" required></textarea>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="cmdUseEmbed" name="cmdUseEmbed">
                                    <label class="form-check-label" for="cmdUseEmbed">Enviar respuesta dentro de un Embed</label>
                                </div>
                                <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-lg me-1"></i> Guardar Auto-Respuesta</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-robot text-info me-2"></i>Auto-Respuestas Activas</div>
                        <div class="card-body">
                            <% if (guild.config.customCommands && guild.config.customCommands.length > 0) { %>
                                <ul class="list-group">
                                    <% guild.config.customCommands.forEach(cmd => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <span class="badge bg-primary me-2"><code><%= cmd.trigger %></code></span>
                                                <span class="badge bg-dark border border-secondary text-muted"><%= cmd.matchType %></span>
                                                <div class="text-white-50 mt-1 small"><%= cmd.response %></div>
                                            </div>
                                            <form action="/servers/<%= currentGuild.id %>/settings#tab-customcommands" method="POST" style="margin: 0;">
                                                <input type="hidden" name="settingType" value="customCommandDelete">
                                                <input type="hidden" name="commandId" value="<%= cmd._id %>">
                                                <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <p class="text-muted">No hay auto-respuestas configuradas en este servidor.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= PESTAÑA: ESTADÍSTICAS EN CANALES ================= -->
