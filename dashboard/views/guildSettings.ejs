                                    <option value="">Ninguno</option>
                                    <% channels.forEach(channel => { %>
                                        <% if (channel.type === 2) { %>
                                            <option value="<%= channel.id %>" <%= guild.config.serverStats && guild.config.serverStats.roleChannelId === channel.id ? 'selected' : '' %>>🔊 <%= channel.name %></option>
