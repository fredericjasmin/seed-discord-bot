                                    <% channels.forEach(channel => { %>
                                        <% if (channel.type === 2) { %>
                                            <option value="<%= channel.id %>" <%= guild.config.serverStats && guild.config.serverStats.botChannelId === channel.id ? 'selected' : '' %>>🔊 <%= channel.name %></option>
