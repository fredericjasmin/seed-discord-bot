<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="mb-4">
    <h2 class="mb-1 text-white">Mi Perfil</h2>
    <p class="text-muted mb-0">Detalles de tu cuenta de usuario e inventario en la economía del bot.</p>
</div>

<% if (message) { %>
    <div class="alert alert-<%= messageType === 'success' ? 'success' : 'danger' %> alert-dismissible fade show mb-4" role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="row g-4">
    <!-- User Info Card -->
    <div class="col-lg-4">
        <div class="card text-center p-4 h-100">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=256" alt="Avatar" class="rounded-circle mx-auto mb-3 border border-2 border-secondary" style="width: 84px; height: 84px; object-fit: cover;">
            <h5 class="text-white mb-1"><%= user.username %></h5>
            <span class="text-muted small mb-3">ID: <code><%= user.id %></code></span>
            <div class="mt-auto pt-3 border-top border-secondary">
                <a href="/auth/logout" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión</a>
            </div>
        </div>
    </div>

    <!-- Economy & Inventory -->
    <div class="col-lg-8">
        <div class="card p-4 mb-3">
            <h5 class="text-white mb-3"><i class="bi bi-wallet2 text-success me-2"></i>Estado Financiero</h5>
            <div class="row g-3 text-center">
                <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded">
                        <span class="text-muted small d-block mb-1">Monedas en Cartera</span>
                        <h4 class="text-success mb-0 fw-bold">🪙 <%= (userData.coins || 0).toLocaleString() %></h4>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-dark border border-secondary rounded">
                        <span class="text-muted small d-block mb-1">Monedas en Banco</span>
                        <h4 class="text-info mb-0 fw-bold">🏦 <%= (userData.bank || 0).toLocaleString() %></h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-4">
            <h5 class="text-white mb-3"><i class="bi bi-bag-check text-warning me-2"></i>Inventario de Objetos</h5>
            <% if (userData.inventory && userData.inventory.length > 0) { %>
                <div class="row g-2">
                    <% userData.inventory.forEach(item => { %>
                        <div class="col-md-6">
                            <div class="p-2 px-3 bg-dark border border-secondary rounded d-flex justify-content-between align-items-center">
                                <span class="text-white small fw-medium"><%= item %></span>
                                <span class="badge bg-secondary">x1</span>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-muted small mb-0">Tu inventario está vacío. Usa comandos como <code>/fish</code>, <code>/mine</code> o visita la <a href="/shop" class="text-success">Tienda</a> para obtener objetos.</p>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>